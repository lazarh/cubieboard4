# U-Boot Kconfig fragment for RAUC integration on CubieBoard4.
#
# Switches U-Boot env storage from FAT file (uboot.env) to raw MMC sectors
# at a fixed offset on the eMMC (mmc dev 1).  A raw-sector env is reliably
# accessible by userspace fw_printenv / fw_setenv, which RAUC's uboot
# bootloader backend uses to read and write BOOT_ORDER / BOOT_x_LEFT.
#
# The env sits at 4MiB (0x400000) on eMMC — well clear of U-Boot itself
# (~1–2MiB) and before partition p1 which starts at 40MiB.
#
# Matching board-side /etc/fw_env.config:
#   /dev/mmcblk2    0x400000    0x20000

# Disable FAT env (was default in Cubieboard4_defconfig)
# CONFIG_ENV_IS_IN_FAT is not set

# Enable raw MMC env
CONFIG_ENV_IS_IN_MMC=y
CONFIG_SYS_MMC_ENV_DEV=1
CONFIG_SYS_MMC_ENV_PART=0
CONFIG_ENV_OFFSET=0x400000
CONFIG_ENV_SIZE=0x20000
