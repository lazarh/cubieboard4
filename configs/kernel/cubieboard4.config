# CubieBoard4 (sun9i / Allwinner A80)
# Docker-ready + WiFi + BT
# Apply on top of sunxi_defconfig using merge_config.sh

############################################################
# --- Wireless: AP6330 (BCM4330) --------------------------
############################################################

CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_PROTO_BCDC=y

############################################################
# --- Bluetooth (AP6330 UART) ------------------------------
############################################################

CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_BCM=m

############################################################
# --- Namespaces (Docker/runc requirement) ----------------
############################################################

CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
# IPC_NS depends on SYSVIPC or POSIX_MQUEUE; enable both to satisfy it
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
# cgroup namespaces (CLONE_NEWCGROUP, Linux 4.6+)
CONFIG_CGROUP_NS=y

############################################################
# --- eBPF (required for cgroup v2 device filtering) ------
############################################################

# runc uses bpf_prog_query(BPF_CGROUP_DEVICE) on cgroup v2
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

############################################################
# --- Cgroups (Docker requirement) ------------------------
############################################################

CONFIG_CGROUPS=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_RDMA=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_PERF=y
CONFIG_BLK_CGROUP=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_KMEM=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_RT_GROUP_SCHED=y

############################################################
# --- Filesystems -----------------------------------------
############################################################

CONFIG_OVERLAY_FS=y
CONFIG_VXLAN=m

############################################################
# --- RAUC streaming --------------------------------------
############################################################

# RAUC HTTP streaming uses the kernel NBD client. Build it in so
# streaming installs work without requiring a separate module load.
CONFIG_BLK_DEV_NBD=y
# RAUC plain bundles are mounted via loop devices on the target.
CONFIG_BLK_DEV_LOOP=y
# Device-mapper lives under the MD menu in Linux 6.6, so enable MD to make
# the DM and dm-verity options visible during config merge.
CONFIG_MD=y
# RAUC verity bundles require device-mapper and dm-verity on the target.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
# Expose the running kernel config via /proc/config.gz for easier target-side
# verification when checking built-in options.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# SQUASHFS: required for RAUC update bundle extraction
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

############################################################
# --- Core Netfilter --------------------------------------
############################################################

CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# Conntrack (CRITICAL for Docker)
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_DEFRAG_IPV4=y

# NAT core
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y

############################################################
# --- iptables / nftables backend -------------------------
############################################################

CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_LOG=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y

############################################################
# --- xtables matches/targets Docker needs ----------------
############################################################

CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_MARK=y

CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y

############################################################
# --- Bridge networking (Docker default) ------------------
############################################################

CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

############################################################
# --- Virtual interfaces (Docker networking) --------------
############################################################

CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_TUN=y
