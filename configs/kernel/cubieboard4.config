# CubieBoard4 (sun9i / Allwinner A80) kernel config fragment
# Applied on top of upstream sunxi_defconfig via merge_config.sh.

# ── BCM4330 WiFi (AMPAK AP6330 module) ────────────────────────────────────
# CONFIG_WIRELESS and CONFIG_CFG80211 must be explicitly enabled — sunxi_defconfig
# leaves them off and olddefconfig silently drops CONFIG_BRCMFMAC without them.
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_RFKILL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_PROTO_BCDC=y

# ── Bluetooth UART (AP6330 BT) ─────────────────────────────────────────────
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y

# ── Docker / container requirements ───────────────────────────────────────
# Namespaces
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# cgroups v1 + v2
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_SCHED=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_MEMCG=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_FAIR_GROUP_SCHED=y
# Overlay filesystem
CONFIG_OVERLAY_FS=y
# iptables / nftables for docker networking
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_IPV4=m
CONFIG_NF_TABLES_IPV6=m
CONFIG_NFT_NAT=m
CONFIG_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=y
CONFIG_DUMMY=m
