# CubieBoard4 (sun9i / Allwinner A80)
# Docker-ready + WiFi + BT
# Apply on top of sunxi_defconfig using merge_config.sh

############################################################
# --- Wireless: AP6330 (BCM4330) --------------------------
############################################################

CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_PROTO_BCDC=y

############################################################
# --- Bluetooth (AP6330 UART) ------------------------------
############################################################

CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_BCM=m

############################################################
# --- Namespaces (Docker requirement) ---------------------
############################################################

CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

############################################################
# --- Cgroups (Docker requirement) ------------------------
############################################################

CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_RDMA=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_PERF=y
CONFIG_BLK_CGROUP=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_KMEM=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_RT_GROUP_SCHED=y

############################################################
# --- Filesystems -----------------------------------------
############################################################

CONFIG_OVERLAY_FS=y
CONFIG_VXLAN=m

############################################################
# --- Core Netfilter --------------------------------------
############################################################

CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# Conntrack (CRITICAL for Docker)
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_DEFRAG_IPV4=y

# NAT core
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y

############################################################
# --- iptables (legacy backend) ---------------------------
############################################################

CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

############################################################
# --- xtables matches/targets Docker needs ----------------
############################################################

CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_MARK=y

CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y

############################################################
# --- Bridge networking (Docker default) ------------------
############################################################

CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

############################################################
# --- Virtual interfaces (Docker networking) --------------
############################################################

CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_TUN=y

############################################################
# --- Disable nft (optional but cleaner for legacy) ------
############################################################

# Uncomment if you want to force legacy-only
# CONFIG_NF_TABLES is not set
# CONFIG_NFT_NAT is not set

